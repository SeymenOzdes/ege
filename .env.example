# Public application identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Ege'nin Nabzı

# Demo aşaması: okur girişi kapalıdır — giriş sayfası ve giriş bağlantıları
# gösterilmez, yalnızca admin hesabı (bkz. supabase/seed.sql + src/lib/auth/dev-access.ts)
# çalışır; admin /auth/dev-login rotasıyla girer. Varsayılan AÇIK ('false'
# verilmedikçe demo modundadır). Demo bittiğinde bu satırı 'false' yapıp
# sunucuyu yeniden başlatın: giriş sayfası kodu silinmeden geri gelir.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (use values from the development project locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never add a NEXT_PUBLIC_ prefix to this value.
SUPABASE_SECRET_KEY=

# Local development quick login: visiting /yonetim signed out automatically
# signs in the seeded local admin (see supabase/seed.sql + src/lib/auth/dev-access.ts).
# Set it to `route` instead to keep the automatic redirect off while leaving
# /auth/dev-login callable by hand — that is what the admin e2e project uses.
# Never enable in production; always unset in CI.
# DEV_ADMIN_AUTO_LOGIN=true

# Bülten onay e-postaları (Modül 14). Ayarlanmazsa abonelik yine kaydedilir ve
# onay bağlantısı sunucu günlüğüne yazılır, böylece yerel geliştirme çalışır.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=

# Future integrations (leave unset until their dedicated module)
# SENTRY_DSN=
